    clRetainKernel=intelocl64.clRetainKernel
    clRetainMemObject=intelocl64.clRetainMemObject
    clRetainProgram=intelocl64.clRetainProgram
    clRetainSampler=intelocl64.clRetainSampler
    clSVMAlloc=intelocl64.clSVMAlloc
    clSVMFree=intelocl64.clSVMFree
    clSetCommandQueueProperty=intelocl64.clSetCommandQueueProperty
    clSetContextDestructorCallback=intelocl64.clSetContextDestructorCallback
    clSetDefaultDeviceCommandQueue=intelocl64.clSetDefaultDeviceCommandQueue
    clSetEventCallback=intelocl64.clSetEventCallback
    clSetKernelArg=intelocl64.clSetKernelArg
    clSetKernelArgSVMPointer=intelocl64.clSetKernelArgSVMPointer
    clSetKernelExecInfo=intelocl64.clSetKernelExecInfo
    clSetMemObjectDestructorCallback=intelocl64.clSetMemObjectDestructorCallback
    clSetProgramReleaseCallback=intelocl64.clSetProgramReleaseCallback
    clSetProgramSpecializationConstant=intelocl64.clSetProgramSpecializationConstant
    clSetUserEventStatus=intelocl64.clSetUserEventStatus
    clUnloadCompiler=intelocl64.clUnloadCompiler
    clUnloadPlatformCompiler=intelocl64.clUnloadPlatformCompiler
    clWaitForEvents=intelocl64.clWaitForEvents
