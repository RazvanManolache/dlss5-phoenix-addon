; Standard OpenCL CPU API forwarding, used only by our owned C++ broker.
; The Intel CPU ICD and its dependencies are user-supplied runtime files.
; OpenGL interop is intentionally absent from this CPU-only interface.
LIBRARY OpenCL
EXPORTS
    clBuildProgram=intelocl64.clBuildProgram
    clCloneKernel=intelocl64.clCloneKernel
    clCompileProgram=intelocl64.clCompileProgram
    clCreateBuffer=intelocl64.clCreateBuffer
    clCreateBufferWithProperties=intelocl64.clCreateBufferWithProperties
    clCreateCommandQueue=intelocl64.clCreateCommandQueue
    clCreateCommandQueueWithProperties=intelocl64.clCreateCommandQueueWithProperties
    clCreateContext=intelocl64.clCreateContext
    clCreateContextFromType=intelocl64.clCreateContextFromType
    clCreateImage=intelocl64.clCreateImage
    clCreateImage2D=intelocl64.clCreateImage2D
    clCreateImage3D=intelocl64.clCreateImage3D
    clCreateImageWithProperties=intelocl64.clCreateImageWithProperties
    clCreateKernel=intelocl64.clCreateKernel
    clCreateKernelsInProgram=intelocl64.clCreateKernelsInProgram
    clCreatePipe=intelocl64.clCreatePipe
    clCreateProgramWithBinary=intelocl64.clCreateProgramWithBinary
    clCreateProgramWithBuiltInKernels=intelocl64.clCreateProgramWithBuiltInKernels
    clCreateProgramWithIL=intelocl64.clCreateProgramWithIL
    clCreateProgramWithSource=intelocl64.clCreateProgramWithSource
    clCreateSampler=intelocl64.clCreateSampler
    clCreateSamplerWithProperties=intelocl64.clCreateSamplerWithProperties
    clCreateSubBuffer=intelocl64.clCreateSubBuffer
    clCreateSubDevices=intelocl64.clCreateSubDevices
    clCreateUserEvent=intelocl64.clCreateUserEvent
    clEnqueueBarrier=intelocl64.clEnqueueBarrier
    clEnqueueBarrierWithWaitList=intelocl64.clEnqueueBarrierWithWaitList
    clEnqueueCopyBuffer=intelocl64.clEnqueueCopyBuffer
    clEnqueueCopyBufferRect=intelocl64.clEnqueueCopyBufferRect
    clEnqueueCopyBufferToImage=intelocl64.clEnqueueCopyBufferToImage
    clEnqueueCopyImage=intelocl64.clEnqueueCopyImage
    clEnqueueCopyImageToBuffer=intelocl64.clEnqueueCopyImageToBuffer
    clEnqueueFillBuffer=intelocl64.clEnqueueFillBuffer
    clEnqueueFillImage=intelocl64.clEnqueueFillImage
    clEnqueueMapBuffer=intelocl64.clEnqueueMapBuffer
    clEnqueueMapImage=intelocl64.clEnqueueMapImage
    clEnqueueMarker=intelocl64.clEnqueueMarker
    clEnqueueMarkerWithWaitList=intelocl64.clEnqueueMarkerWithWaitList
    clEnqueueMigrateMemObjects=intelocl64.clEnqueueMigrateMemObjects
    clEnqueueNDRangeKernel=intelocl64.clEnqueueNDRangeKernel
    clEnqueueNativeKernel=intelocl64.clEnqueueNativeKernel
    clEnqueueReadBuffer=intelocl64.clEnqueueReadBuffer
    clEnqueueReadBufferRect=intelocl64.clEnqueueReadBufferRect
    clEnqueueReadImage=intelocl64.clEnqueueReadImage
    clEnqueueSVMFree=intelocl64.clEnqueueSVMFree
    clEnqueueSVMMap=intelocl64.clEnqueueSVMMap
    clEnqueueSVMMemFill=intelocl64.clEnqueueSVMMemFill
    clEnqueueSVMMemcpy=intelocl64.clEnqueueSVMMemcpy
    clEnqueueSVMMigrateMem=intelocl64.clEnqueueSVMMigrateMem
    clEnqueueSVMUnmap=intelocl64.clEnqueueSVMUnmap
    clEnqueueTask=intelocl64.clEnqueueTask
    clEnqueueUnmapMemObject=intelocl64.clEnqueueUnmapMemObject
    clEnqueueWaitForEvents=intelocl64.clEnqueueWaitForEvents
    clEnqueueWriteBuffer=intelocl64.clEnqueueWriteBuffer
    clEnqueueWriteBufferRect=intelocl64.clEnqueueWriteBufferRect
    clEnqueueWriteImage=intelocl64.clEnqueueWriteImage
    clFinish=intelocl64.clFinish
    clFlush=intelocl64.clFlush
    clGetCommandQueueInfo=intelocl64.clGetCommandQueueInfo
    clGetContextInfo=intelocl64.clGetContextInfo
    clGetDeviceAndHostTimer=intelocl64.clGetDeviceAndHostTimer
    clGetDeviceIDs=intelocl64.clGetDeviceIDs
    clGetDeviceInfo=intelocl64.clGetDeviceInfo
    clGetEventInfo=intelocl64.clGetEventInfo
    clGetEventProfilingInfo=intelocl64.clGetEventProfilingInfo
    clGetExtensionFunctionAddress=intelocl64.clGetExtensionFunctionAddress
    clGetExtensionFunctionAddressForPlatform=intelocl64.clGetExtensionFunctionAddressForPlatform
    clGetHostTimer=intelocl64.clGetHostTimer
    clGetImageInfo=intelocl64.clGetImageInfo
    clGetKernelArgInfo=intelocl64.clGetKernelArgInfo
    clGetKernelInfo=intelocl64.clGetKernelInfo
    clGetKernelSubGroupInfo=intelocl64.clGetKernelSubGroupInfo
    clGetKernelWorkGroupInfo=intelocl64.clGetKernelWorkGroupInfo
    clGetMemObjectInfo=intelocl64.clGetMemObjectInfo
    clGetPipeInfo=intelocl64.clGetPipeInfo
    clGetPlatformIDs=intelocl64.clGetPlatformIDs
    clGetPlatformInfo=intelocl64.clGetPlatformInfo
    clGetProgramBuildInfo=intelocl64.clGetProgramBuildInfo
    clGetProgramInfo=intelocl64.clGetProgramInfo
    clGetSamplerInfo=intelocl64.clGetSamplerInfo
    clGetSupportedImageFormats=intelocl64.clGetSupportedImageFormats
    clLinkProgram=intelocl64.clLinkProgram
    clReleaseCommandQueue=intelocl64.clReleaseCommandQueue
