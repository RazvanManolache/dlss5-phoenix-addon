#version 450
// Phoenix exact 64-token attention: scores and probabilities stay in shared memory.
// Resident ABI is compatible with the private Intel runtime (Apache-2.0 NOTICE).
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#include "publish.glsl"
#ifndef PHX_ATTENTION_M
#define PHX_ATTENTION_M 16
#endif
#define PHX_ATTENTION_LANES (32 * (64 / PHX_ATTENTION_M))
layout(local_size_x = PHX_ATTENTION_LANES) in;
layout(constant_id = 0) const bool MERGED_OUTPUT = false;
layout(buffer_reference, scalar, buffer_reference_align = 2) buffer HalfBuf {
    float16_t v[];
};
layout(buffer_reference, scalar, buffer_reference_align = 4) buffer FloatBuf {
    float v[];
};
// Resident packet: q/k/v are query/key/value addresses; m is rows,
// sa/sb/sc are batch strides and lda/ldb/ldc are row strides (in elements).
// Reserved p0..p3/unused/spare slots retain their ABI offsets.
layout(push_constant, scalar) uniform Push {
    HalfBuf q, k;
    FloatBuf output_data;
    HalfBuf v;
    uint m, heads, unused, batches, sa, sb, sc, flags;
    float p0, p1, p2, p3;
    uint lda, ldb, ldc, spare;
    FloatBuf bias;
}
pc;
shared float scores[4096];
shared float16_t probabilities[4096];
// Add with an explicit half-precision publication boundary; the reduction
// must retain this rounding rather than accumulate the entire row in float.
float ha(float left, float right) {
    return half_round(left + right);
}
float member(float value, uint lane) {
    return subgroupShuffle(value, (gl_SubgroupInvocationID & ~7u) + lane);
}
float reciprocal(float denominator) {
    if (isinf(denominator))
        return 0.;
    precise float estimate = 1. / denominator;
    precise float error = fma(-estimate, denominator, 1.);
    return fma(error, estimate, estimate);
}
// Compute Q*K^T, publish normalized weights to shared memory, then compute
// weights*V. The two barriers make each shared tensor visible across all
// subgroups; merged output finally restores token-major channel ordering.
void main() {
    uint batch = gl_WorkGroupID.y + gl_WorkGroupID.z * 65535u;
    if (batch >= pc.batches)
        return;
    uint local = gl_LocalInvocationID.x, subgroup_index = local / 32u;
    uint row = subgroup_index * PHX_ATTENTION_M, offset = batch * 64u * 32u;
    coopmat<float, gl_ScopeSubgroup, PHX_ATTENTION_M, 16, gl_MatrixUseAccumulator> score_tiles[4];
    for (uint inner_index = 0u; inner_index < 4u; inner_index++)
        score_tiles[inner_index] =
            coopmat<float, gl_ScopeSubgroup, PHX_ATTENTION_M, 16, gl_MatrixUseAccumulator>(0.);
    for (uint reduction_base = 0u; reduction_base < 32u; reduction_base += 16u) {
        coopmat<float16_t, gl_ScopeSubgroup, PHX_ATTENTION_M, 16, gl_MatrixUseA> query_tile;
        coopMatLoad(query_tile, pc.q.v, offset + row * 32u + reduction_base, 32,
                    gl_CooperativeMatrixLayoutRowMajor);
        for (uint inner_index = 0u; inner_index < 4u; inner_index++) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> key_tile;
            coopMatLoad(key_tile, pc.k.v, offset + inner_index * 16u * 32u + reduction_base, 32,
                        gl_CooperativeMatrixLayoutColumnMajor);
            score_tiles[inner_index] =
                coopMatMulAdd(query_tile, key_tile, score_tiles[inner_index]);
        }
    }
    for (uint inner_index = 0u; inner_index < 4u; inner_index++)
        coopMatStore(score_tiles[inner_index], scores, row * 64u + inner_index * 16u, 64,
                     gl_CooperativeMatrixLayoutRowMajor);
    subgroupMemoryBarrierShared();
    subgroupBarrier();
    uint lane = local % 8u;
    bool split = pc.heads == 16u;
    // Normalize only this subgroup's score rows. Eight lanes retain the
    // original arithmetic tree for each row; ownership no longer crosses warps.
    for (uint query_index = row + (local % 32u) / 8u;
         query_index < row + PHX_ATTENTION_M; query_index += 4u) {
        float weights[8];
        for (uint iteration_index = 0u; iteration_index < 8u; iteration_index++) {
            uint key = lane + iteration_index * 8u;
            float score = scores[query_index * 64u + key];
            float position_bias =
                pc.flags != 0u ? pc.bias.v[((batch % pc.heads) * 64u + query_index) * 64u + key]
                               : 0.;
            float ramp =
                split ? half_round(fma(half_round(score + position_bias), .044921875, 1.30078125))
                      : half_round(
                            fma(score, .044921875, fma(position_bias, .044921875, 1.30078125)));
            ramp = clamp(ramp, 1.03125, 1.5693359375);
            weights[iteration_index] = phoenix_half_value((phoenix_half_bits(ramp) & 1023u) << 5u);
        }
        precise float total;
        if (split) {
            precise float even_sum = ((weights[0] + weights[2]) + weights[4]) + weights[6],
                          odd_sum = ((weights[1] + weights[3]) + weights[5]) + weights[7];
            precise float even_total = ((member(even_sum, 0u) + member(even_sum, 1u)) +
                                        (member(even_sum, 2u) + member(even_sum, 3u))) +
                                       ((member(even_sum, 4u) + member(even_sum, 5u)) +
                                        (member(even_sum, 6u) + member(even_sum, 7u)));
            precise float odd_total = ((member(odd_sum, 0u) + member(odd_sum, 1u)) +
                                       (member(odd_sum, 2u) + member(odd_sum, 3u))) +
                                      ((member(odd_sum, 4u) + member(odd_sum, 5u)) +
                                       (member(odd_sum, 6u) + member(odd_sum, 7u)));
            total = even_total + odd_total;
        } else {
            float even_sum = ha(ha(ha(weights[0], weights[2]), weights[4]), weights[6]);
            float odd_sum = ha(ha(ha(weights[1], weights[3]), weights[5]), weights[7]);
            float probability_tile =
                ha(ha(ha(even_sum, member(even_sum, (lane % 4u) + 4u)), odd_sum),
                   member(odd_sum, (lane % 4u) + 4u));
            total = ha(ha(member(probability_tile, 0u), member(probability_tile, 1u)),
                       ha(member(probability_tile, 2u), member(probability_tile, 3u)));
        }
        float inverse = reciprocal(max(total, .00006103515625));
        for (uint iteration_index = 0u; iteration_index < 8u; iteration_index++)
            probabilities[query_index * 64u + lane + iteration_index * 8u] =
                float16_t(e4m3(half_round(weights[iteration_index] * inverse)));
    }
    subgroupMemoryBarrierShared();
    subgroupBarrier();
    coopmat<float, gl_ScopeSubgroup, PHX_ATTENTION_M, 16, gl_MatrixUseAccumulator> context_tiles[2];
    for (uint inner_index = 0u; inner_index < 2u; inner_index++)
        context_tiles[inner_index] =
            coopmat<float, gl_ScopeSubgroup, PHX_ATTENTION_M, 16, gl_MatrixUseAccumulator>(0.);
    for (uint reduction_base = 0u; reduction_base < 64u; reduction_base += 16u) {
        coopmat<float16_t, gl_ScopeSubgroup, PHX_ATTENTION_M, 16, gl_MatrixUseA> probability_tile;
        coopMatLoad(probability_tile, probabilities, row * 64u + reduction_base, 64,
                    gl_CooperativeMatrixLayoutRowMajor);
        for (uint inner_index = 0u; inner_index < 2u; inner_index++) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> value_tile;
            coopMatLoad(value_tile, pc.v.v, offset + reduction_base * 32u + inner_index * 16u, 32,
                        gl_CooperativeMatrixLayoutRowMajor);
            context_tiles[inner_index] =
                coopMatMulAdd(probability_tile, value_tile, context_tiles[inner_index]);
        }
    }
    for (uint inner_index = 0u; inner_index < 2u; inner_index++) {
        if (MERGED_OUTPUT)
            coopMatStore(context_tiles[inner_index], scores, row * 64u + inner_index * 16u, 64,
                         gl_CooperativeMatrixLayoutRowMajor);
        else
            coopMatStore(context_tiles[inner_index], pc.output_data.v,
                         offset + row * 32u + inner_index * 16u, 32,
                         gl_CooperativeMatrixLayoutRowMajor);
    }
    if (MERGED_OUTPUT) {
        subgroupMemoryBarrierShared();
    subgroupBarrier();
        // Reuse the same subgroup-owned score rows as context staging.
        // Compacting them to a 32-column pitch would overwrite another warp's
        // scores before it finishes normalization without a workgroup barrier.
        for (uint element_index = row * 32u + local % 32u;
             element_index < (row + PHX_ATTENTION_M) * 32u; element_index += 32u) {
            uint target = ((batch / pc.heads) * 64u + element_index / 32u) * pc.heads * 32u +
                          (batch % pc.heads) * 32u + element_index % 32u;
            HalfBuf(uint64_t(pc.output_data)).v[target] =
                float16_t(e4m3(half_round(scores[(element_index / 32u) * 64u + element_index % 32u])));
        }
    }
}
