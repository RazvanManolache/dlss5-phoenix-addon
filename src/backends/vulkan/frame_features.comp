#version 450
// Device packing of the portable model input. Noise is generated/cached on the
// host; RGB centering and all explicit half-rounding match FrameState::features.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#include "publish.glsl"
layout(local_size_x = 256) in;
layout(buffer_reference, scalar, buffer_reference_align = 4) buffer Floats { float v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 2) buffer Halves { float16_t v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 4) buffer Words { uint v[]; };
layout(push_constant, scalar) uniform Push {
    Floats color, prior;
    Halves output_data, noise;
    uint height, width, padded_width, padded_height, style, tone_bits, structure_bits, auto_mask;
    float p0, p1, p2, p3;
    uint skin_bits, ldb, ldc, spare;
    Words valid;
} pc;
uint mirrored(uint value, uint extent) {
    return uint(clamp(value < extent ? int(value) : 2 * int(extent) - int(value) - 2, 0, int(extent) - 1));
}
float centered(float value) { return half_round(half_round(half_round(value) - .5) * .125); }
void main() {
    uint pixel = (gl_WorkGroupID.x + gl_WorkGroupID.z * gl_NumWorkGroups.x) * 256u + gl_LocalInvocationID.x;
    if (pixel >= pc.padded_width * pc.padded_height) return;
    uint x = pixel % pc.padded_width, y = pixel / pc.padded_width;
    uint source = mirrored(y, pc.height) * pc.width + mirrored(x, pc.width);
    bool valid = ((pc.valid.v[source >> 2u] >> ((source & 3u) * 8u)) & 255u) != 0u;
    for (uint channel = 0; channel < 3; ++channel) {
        pc.output_data.v[pixel * 16u + channel] = pc.noise.v[pixel * 3u + channel];
        float current = centered(pc.color.v[source * 3u + channel]);
        pc.output_data.v[pixel * 16u + 4u + channel] = float16_t(current);
        pc.output_data.v[pixel * 16u + 7u + channel] = float16_t(valid ? centered(pc.prior.v[source * 3u + channel]) : current);
    }
    float structure = uintBitsToFloat(pc.structure_bits), skin = uintBitsToFloat(pc.skin_bits);
    pc.output_data.v[pixel * 16u + 3u] = float16_t(1);
    pc.output_data.v[pixel * 16u + 10u] = float16_t(half_round(float(pc.style) / 128.));
    pc.output_data.v[pixel * 16u + 11u] = float16_t(half_round(uintBitsToFloat(pc.tone_bits)));
    pc.output_data.v[pixel * 16u + 12u] = float16_t(half_round(pc.auto_mask != 0u ? 1. : structure));
    pc.output_data.v[pixel * 16u + 13u] = float16_t(half_round(pc.auto_mask != 0u ? (skin < 0. ? structure : skin) : -1.));
    pc.output_data.v[pixel * 16u + 14u] = float16_t(half_round(pc.auto_mask != 0u ? structure : -1.));
    pc.output_data.v[pixel * 16u + 15u] = float16_t(0);
}
