#version 450
// Derived from Intel NR gemm_resident.comp, Apache-2.0 (third_party/intel_nr/NOTICE).
// Phoenix: capability-selected tile height, zero-padded boundary loads, unchanged
// resident ABI and Phoenix publication arithmetic. No device-specific lane layout.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_shader_subgroup_basic : require
#include "publish.glsl"
#ifndef MATRIX_M
#define MATRIX_M 16
#endif
#ifndef MATRIX_WARPS
#define MATRIX_WARPS 1
#endif
#ifdef FP8_K
#include "phoenix_fp8.glsl"
#endif

#ifndef MATRIX_REDUCTION
#define MATRIX_REDUCTION 32
#endif
#ifndef COALESCED_MATRIX_WEIGHTS
#define COALESCED_MATRIX_WEIGHTS 1
#endif
#ifdef FP8_K
#define STAGED_REDUCTION FP8_K
#else
#define STAGED_REDUCTION MATRIX_REDUCTION
#endif
layout(local_size_x = 32 * MATRIX_WARPS) in;
layout(buffer_reference, scalar, buffer_reference_align = 2) buffer HalfBuf {
    float16_t v[];
};
layout(buffer_reference, scalar, buffer_reference_align = 4) buffer FloatBuf {
    float v[];
};
// Stable resident packet: a/b inputs, c output, d auxiliary, m/n/k GEMM
// dimensions, sa/sb/sc batch strides, lda/ldb/ldc row strides in elements.
// p0..p3 are scalar parameters; residual_cos carries the optional extra view.
layout(push_constant, scalar) uniform Push {
    HalfBuf a, b;
    FloatBuf c, d;
    uint m, n, k, batch, sa, sb, sc, flags;
    float p0, p1, p2, p3;
    uint lda, ldb, ldc, spare;
    uint64_t residual_cos;
    uint image_h, image_w, window_cols, window_pad;
    uint64_t qkv_scale;
}
pc;
#include "specialize.glsl"
#include "packed_weight.glsl"
shared float16_t a_tile[MATRIX_M * MATRIX_WARPS * STAGED_REDUCTION];
shared float16_t b_tile[STAGED_REDUCTION * 16];
shared float output_tile[MATRIX_M * MATRIX_WARPS * 16];
shared float ordered_left[MATRIX_M * MATRIX_WARPS * 32];
shared float ordered_right[32 * 16];
// Each subgroup owns one output tile. Boundary loads contribute zeros;
// the deterministic image-boundary projections retain ascending K/FMA order,
// while inner layers use cooperative matrix multiplication and publication.


void main() {
    uint flags = operation_flags();
    uint left_row_stride = pc.lda == 0u ? pc.k : pc.lda;
    uint right_row_stride = pc.ldb == 0u ? ((flags & 1u) != 0u ? pc.k : pc.n) : pc.ldb;
    uint output_row_stride = pc.ldc == 0u ? pc.n : pc.ldc;
    const uint block_rows = MATRIX_M * MATRIX_WARPS;
    uint row_tiles = (pc.m + block_rows - 1u) / block_rows;
    uint tile = gl_WorkGroupID.y + gl_WorkGroupID.z * gl_NumWorkGroups.y;
    uint batch_index = tile / row_tiles;
    if (batch_index >= max(pc.batch, 1u))
        return;
    uint left_batch_offset = batch_index * pc.sa, right_batch_offset = batch_index * pc.sb,
         output_batch_offset = batch_index * pc.sc;
    uint thread_index = gl_LocalInvocationID.x, lane = thread_index % 32u;
    uint warp = thread_index / 32u, shared_offset = warp * MATRIX_M * 16u;
    uint block_row = (tile % row_tiles) * block_rows;
    uint rowbase = block_row + warp * MATRIX_M,
         colbase = gl_WorkGroupID.x * 16u;
    // The unquantized image lift publishes half values. Reordering its FP32
    // reduction can cross a half midpoint, which later FP8 layers amplify.
    // The small unquantized 32->16 output head also feeds FP16 history. Keep
    // both boundary projections deterministic while matrix ops run inside.
    uint epilogue = (flags >> 8u) & 15u;
    if ((flags & 0x2000000u) == 0u &&
        (epilogue == 4u || (epilogue == 0u && pc.k == 32u && pc.n == 16u))) {
        // Four columns share each ordered input load in registers. Compact
        // image heads use all lanes on their four live output columns.
        for (uint tile_element = lane; tile_element < MATRIX_M * 4u; tile_element += 32u) {
            uint row = rowbase + tile_element / 4u, column = colbase + tile_element % 4u;
            if (row >= pc.m || column >= pc.n || ((flags & 0x10000u) != 0u && column >= 4u))
                continue;
            precise float values[4] = float[4](0.0, 0.0, 0.0, 0.0);
            uint columns = (flags & 0x10000u) != 0u ? 1u : 4u;
            for (uint reduction_index = 0u; reduction_index < pc.k; ++reduction_index) {
                float left_value =
                    float(pc.a.v[left_batch_offset + row * left_row_stride + reduction_index]);
                for (uint inner_index = 0u; inner_index < columns; ++inner_index) {
                    uint output_column = column + inner_index * 4u;
                    if (output_column < pc.n) {
                        float right_value =
                            matrix_b(right_batch_offset +
                                     ((flags & 1u) != 0u
                                          ? output_column * right_row_stride + reduction_index
                                          : reduction_index * right_row_stride + output_column));
                        values[inner_index] = fma(left_value, right_value, values[inner_index]);
                    }
                }
            }
            for (uint inner_index = 0u; inner_index < columns; ++inner_index) {
                uint output_column = column + inner_index * 4u;
                if (output_column >= pc.n)
                    continue;
                float value = publish(epilogue, values[inner_index]);
                uint output_offset = output_batch_offset + row * output_row_stride + output_column;
                if ((flags & 0x1000u) != 0u)
                    HalfBuf(uint64_t(pc.c)).v[output_offset] = float16_t(half_round(value));
                else
                    pc.c.v[output_offset] = value;
            }
        }
        return;
    }
    if ((flags & 0x2000000u) == 0u) {
        precise float accumulators[MATRIX_M / 2];
        for (uint slot = 0u; slot < MATRIX_M / 2; ++slot) accumulators[slot] = 0.0;
        for (uint reduction_base = 0u; reduction_base < pc.k; reduction_base += 32u) {
            for (uint element = thread_index; element < block_rows * 32u; element += 32u * MATRIX_WARPS) {
                uint source_row = block_row + element / 32u, reduction = reduction_base + element % 32u;
                ordered_left[element] = source_row < pc.m && reduction < pc.k
                    ? float(pc.a.v[left_batch_offset + source_row * left_row_stride + reduction]) : 0.0;
            }
            for (uint element = thread_index; element < 512u; element += 32u * MATRIX_WARPS) {
                uint reduction = reduction_base + element / 16u, column = colbase + element % 16u;
                ordered_right[element] = reduction < pc.k && column < pc.n
                    ? matrix_b(right_batch_offset + ((flags & 1u) != 0u
                        ? column * right_row_stride + reduction : reduction * right_row_stride + column)) : 0.0;
            }
            barrier();
            for (uint reduction = 0u; reduction < min(32u, pc.k - reduction_base); ++reduction)
                for (uint slot = 0u; slot < MATRIX_M / 2; ++slot) {
                    uint element = lane + slot * 32u;
                    accumulators[slot] = fma(ordered_left[warp * MATRIX_M * 32u + (element / 16u) * 32u + reduction],
                                              ordered_right[reduction * 16u + element % 16u], accumulators[slot]);
                }
            barrier();
        }
        for (uint slot = 0u; slot < MATRIX_M / 2; ++slot) {
            uint element = lane + slot * 32u, row = rowbase + element / 16u, column = colbase + element % 16u;
            if (row >= pc.m || column >= pc.n) continue;
            uint target = output_batch_offset + row * output_row_stride + column;
            float value = publish(epilogue, accumulators[slot]);
            if ((flags & 0x1000u) != 0u) HalfBuf(uint64_t(pc.c)).v[target] = float16_t(half_round(value));
            else pc.c.v[target] = value;
        }
        return;
    }
    coopmat<float, gl_ScopeSubgroup, MATRIX_M, 16, gl_MatrixUseAccumulator> sum =
        coopmat<float, gl_ScopeSubgroup, MATRIX_M, 16, gl_MatrixUseAccumulator>(0.0);
#ifdef FP8_K
    const uint step_k = FP8_K;
#else
    const uint step_k = MATRIX_REDUCTION;
#endif
    for (uint kb = 0u; kb < pc.k; kb += step_k) {
#ifdef FP8_K
        // Lossless narrowing only. Some boundary/transition operands are true
        // FP16, so a tile that cannot be represented exactly keeps FP16 math.
        // Graph-marked activations were already published to the E4M3 grid.
        // Their weights are validated E4M3 bytes, so no per-tile round-trip
        // test or atomic vote is necessary. True FP16 boundaries still vote.
        bool known_fp8 = (flags & 0x10000000u) != 0u;
        if (!known_fp8 && lane == 0u)
            fp8_inexact = 0u;
        if (!known_fp8)
            barrier();
        for (uint tile_element = lane; tile_element < 16u * FP8_K; tile_element += 32u) {
            uint row = rowbase + tile_element / FP8_K, reduction_index = kb + tile_element % FP8_K;
            float left_value =
                row < pc.m && reduction_index < pc.k
                    ? float(pc.a.v[left_batch_offset + row * left_row_stride + reduction_index])
                    : 0.0;
            uint column = colbase + tile_element / FP8_K;
            uint weight_index = right_batch_offset +
                                ((flags & 1u) != 0u ? column * right_row_stride + reduction_index
                                                    : reduction_index * right_row_stride + column);
            uint weight_code = column < pc.n && reduction_index < pc.k
                                   ? (WeightWords(uint64_t(pc.b)).v[weight_index >> 2u] >>
                                      ((weight_index & 3u) * 8u)) &
                                         255u
                                   : 0u;
            a_fp8[tile_element] = floate4m3_t(left_value);
            // Reinterpret the byte directly; decoding to float and converting
            // straight back to E4M3 repeats work for every matrix tile.
            b_fp8[tile_element] = uintBitsToFloate4m3EXT(uint8_t(weight_code));
            if (!known_fp8 && float(a_fp8[tile_element]) != left_value)
                atomicOr(fp8_inexact, 1u);
        }
        barrier();
        if (known_fp8 || fp8_inexact == 0u) {
            PHX_FRAG_A8 a8;
            PHX_FRAG_B8 b8;
            PHX_LOAD_A8(a8, a_fp8);
            PHX_LOAD_B8(b8, b_fp8);
            sum = coopMatMulAdd(a8, b8, sum);
            barrier();
            continue;
        }
#endif

        // Stage a larger reduction chunk once. The cooperative arithmetic below
        // still advances in ascending 16-element steps, preserving every MMA.
        // Every subgroup must participate when the collective shared tile is needed.
        bool direct_left = block_row + block_rows <= pc.m && kb + step_k <= pc.k &&
                           left_row_stride % 8u == 0u;
        if (!direct_left)
            for (uint element = thread_index; element < block_rows * step_k; element += 32u * MATRIX_WARPS) {
                uint row = block_row + element / step_k, reduction = kb + element % step_k;
                a_tile[element] = row < pc.m && reduction < pc.k
                    ? pc.a.v[left_batch_offset + row * left_row_stride + reduction] : float16_t(0.0);
            }
        bool packed_contiguous = COALESCED_MATRIX_WEIGHTS != 0 && (flags & 0x2000001u) == 0x2000001u &&
                                 right_row_stride % 4u == 0u && right_batch_offset % 4u == 0u;
        if (packed_contiguous) {
            // Weight rows are output channels; adjacent lanes fetch consecutive
            // reduction words, then transpose their four decoded values in shared memory.
            for (uint word = thread_index; word < 16u * step_k / 4u; word += 32u * MATRIX_WARPS) {
                uint column = colbase + word / (step_k / 4u), local_reduction = (word % (step_k / 4u)) * 4u;
                uint reduction = kb + local_reduction;
                uint codes = reduction < pc.k && column < pc.n
                    ? WeightWords(uint64_t(pc.b)).v[(right_batch_offset + column * right_row_stride + reduction) / 4u] : 0u;
                // A padded weight row may end inside the last loaded word.
                // Mask those bytes so both sides of a tail product remain zero.
                if ((pc.k & 3u) != 0u && reduction < pc.k && reduction + 4u > pc.k)
                    codes &= (1u << ((pc.k - reduction) * 8u)) - 1u;
                for (uint byte = 0u; byte < 4u; ++byte)
                    b_tile[(column - colbase) * step_k + local_reduction + byte] =
                        float16_t(decoded_weight_byte((codes >> (byte * 8u)) & 255u));
            }
        } else {
            for (uint element = thread_index; element < step_k * 16u; element += 32u * MATRIX_WARPS) {
                uint reduction = kb + element / 16u, column = colbase + element % 16u;
                b_tile[(element % 16u) * step_k + element / 16u] = reduction < pc.k && column < pc.n
                    ? float16_t(matrix_b(right_batch_offset + ((flags & 1u) != 0u
                        ? column * right_row_stride + reduction : reduction * right_row_stride + column))) : float16_t(0.0);
            }
        }
        barrier();
        for (uint sub_k = 0u; sub_k < min(step_k, pc.k - kb); sub_k += 16u) {
            coopmat<float16_t, gl_ScopeSubgroup, MATRIX_M, 16, gl_MatrixUseA> a;
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> b;
            if (direct_left)
                coopMatLoad(a, pc.a.v, left_batch_offset + rowbase * left_row_stride + kb + sub_k,
                            left_row_stride, gl_CooperativeMatrixLayoutRowMajor);
            else
                coopMatLoad(a, a_tile, warp * MATRIX_M * step_k + sub_k, step_k,
                            gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(b, b_tile, sub_k, step_k, gl_CooperativeMatrixLayoutColumnMajor);
            sum = coopMatMulAdd(a, b, sum);
        }
        barrier();
    }
    coopMatStore(sum, output_tile, shared_offset, 16, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    for (uint tile_element = lane; tile_element < MATRIX_M * 16u; tile_element += 32u) {
        uint row = rowbase + tile_element / 16u, column = colbase + tile_element % 16u;
        if (row >= pc.m || column >= pc.n || ((flags & 0x10000u) != 0u && column >= 4u))
            continue;
        uint output_offset = output_batch_offset + row * output_row_stride + column;
        precise float value = output_tile[shared_offset + tile_element];
        if ((flags & 0x4000000u) != 0u) {
            float skip = (flags & 0x8000000u) != 0u
                             ? float(HalfBuf(uint64_t(pc.d)).v[output_offset]) : pc.d.v[output_offset];
            precise float product = skip * FloatBuf(pc.residual_cos).v[column];
            value = value + product;
        }
        value = publish((flags >> 8u) & 15u, value);
        if ((flags & 0x1000u) != 0u)
            HalfBuf(uint64_t(pc.c)).v[output_offset] = float16_t(half_round(value));
        else
            pc.c.v[output_offset] = value;
    }
}
