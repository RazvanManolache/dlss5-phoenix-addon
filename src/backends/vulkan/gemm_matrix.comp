                    reduction_index < pc.k && column < pc.n
                        ? float16_t(matrix_b(right_batch_offset +
                                             ((flags & 1u) != 0u
                                                  ? column * right_row_stride + reduction_index
                                                  : reduction_index * right_row_stride + column)))
                        : float16_t(half_round(0));
