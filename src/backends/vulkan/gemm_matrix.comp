        uint row = rowbase + tile_element / 16u, column = colbase + tile_element % 16u;
        if (row >= pc.m || column >= pc.n || ((flags & 0x10000u) != 0u && column >= 4u))
            continue;
        float value = publish((flags >> 8u) & 15u, output_tile[tile_element]);
        uint output_offset = output_batch_offset + row * output_row_stride + column;
        if ((flags & 0x1000u) != 0u)
            HalfBuf(uint64_t(pc.c)).v[output_offset] = float16_t(half_round(value));
        else
            pc.c.v[output_offset] = value;
    }
}
