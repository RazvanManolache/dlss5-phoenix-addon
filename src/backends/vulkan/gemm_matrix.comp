                            right_row_stride, gl_CooperativeMatrixLayoutColumnMajor);
            else
                coopMatLoad(b, pc.b.v, right_batch_offset + kb * right_row_stride + colbase,
                            right_row_stride, gl_CooperativeMatrixLayoutRowMajor);
